generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Untitled Workflow")
  nodes     Json
  edges     Json
  viewport  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      WorkflowRun[]

  @@index([userId])
}

model WorkflowRun {
  id            String              @id @default(cuid())
  workflowId    String
  workflow      Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId        String
  status        RunStatus           @default(PENDING)
  scope         RunScope            @default(FULL)
  selectedNodes String[]
  inputs        Json
  nodeResults   WorkflowNodeResult[]
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  duration      Int?
  triggerRunId  String?
  error         String?

  @@index([workflowId])
  @@index([userId])
}

model WorkflowNodeResult {
  id          String      @id @default(cuid())
  runId       String
  run         WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeType    String
  status      NodeStatus  @default(PENDING)
  inputs      Json?
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int?
  error       String?

  @@index([runId])
  @@unique([runId, nodeId])
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum NodeStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum RunScope {
  FULL
  PARTIAL
  SINGLE_NODE
}
